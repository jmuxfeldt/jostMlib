EXAMPLES::

Note:: Items

Use a String to trigger the defaultAction (and globalAction).

If a String starts with "-", it creates a menu separator.

Use an Association to trigger the associated function (and globalAction).

Use a MenuAction to customize all aspects of the menu, and trigger the associated action (and globalAction).

Use a ActionQSubMenu to create a sub-menu.
::

code::
(
w = Window.new("ActionMenu Examples").front;
// action arguments are |val,modifier,buttonNum|
w.flow{arg w;
	var b;
	ActionQMenu(w,Rect(0,0,80,25),"Vocalize",[
		\sing ->{|val,modifier,buttonNum|[ val,modifier,buttonNum].postln},
		\shout ->{|val,modifier,buttonNum|[ val,modifier,buttonNum].postln},
		\grunt ->{|val,modifier,buttonNum|[ val,modifier,buttonNum].postln},
	]);

	// Chosen value shown on button label; Use a globalAction.
	b=ActionQMenu(w,Rect(0,0,80,25),"Select",["fast","medium","slow"]).globalAction_{|action|
		b.button.states_([[action.string]]);
		b.button.refresh;
		b.button.focus(0);
	};
	w.startRow;

}
)
::
code::
// add Sub menus, use icons

(
~icon = Image(40).draw({
	Pen.fillColor = Color.green;
	Pen.fillOval(Rect(10, 10, 20, 20));
});

w = Window.new("ActionMenu Examples").front;
// action arguments are |val,modifier,buttonNum|
w.flow{arg w;
	var r=ActionQMenu(w,120@30,"testmenu",[
		"-divider example",
		'Test1'->{"-> Test1".postln},
		"-test2",
		MenuAction("Test2").action_({|a|"-> ".post; a.postln}),
		MenuAction("Test3").icon_(~icon),
		"Test4", // Plain text item uses defaultAction
		"-",
		ActionQSubMenu("Submenu1",[
			'Submenu1.test1'->{"-> Submenu1.test1".postln},
			MenuAction("Submenu1.test2"),
			"Submenu1.test3",
			ActionQSubMenu("SubSubmenu",[
				'Submenu2.test1'->{"-> SubSubmenu.test1".postln},
				MenuAction("SubSubmenu.test2"),
				"SubSubmenu.test3"
			])

		])

	],{"-> default action".postln},{"-> global action".postln;"".postln});
	// if you want defaultAction and globalAction to propogate to submenus,
	// they must be in the top menu constructor.
};
)
::
code::

(
// to attach to MainMenu use  *newMenuOnly

var amenu;
FlowView.new.flow{|w| StaticText(w, 300@30).string_("Look at the macOS menu")};
amenu=ActionQMenu.newMenuOnly(nil,120@30,"testmenu",[
	"-divider example",
	'Test1'->{"-> Test1".postln},
	"-test2",
	MenuAction("Test2").action_({|a|"-> ".post; a.postln}),
	MenuAction("Test3"),
	"Test4", // Plain text item uses defaultAction
	"-",
	ActionQSubMenu("Submenu1",[
		'Submenu1.test1'->{"-> Submenu1.test1".postln},
		MenuAction("Submenu1.test2"),
		"Submenu1.test3",
		ActionQSubMenu("SubSubmenu",[
			'Submenu2.test1'->{"-> SubSubmenu.test1".postln},
			MenuAction("SubSubmenu.test2"),
			"SubSubmenu.test3"
		])

	])

],{"-> default action".postln},{"-> global action".postln;"".postln});

MainMenu.register(amenu.menu, "TestActions");

amenu.menu.actions.do{|act|
	MainMenu.register(act, "TestActions2");
}

)
::