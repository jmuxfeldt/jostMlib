EXAMPLES::
Note:: items

A String is interpreted as file or folder paths (except if they start with "-");

A String ending in "/*" will iterated over the files in the directory on the top level.

If a String starts with "-", it creates a menu separator.

Use an Association to trigger the associated function (and globalAction).

Use a MenuAction to customize all aspects of the menu, and trigger the associated action (and globalAction).

Use a ActionQSubMenu to create a sub-menu.
::

code::
(
// Make sure the paths are present, or they will be ignored.
// Associations work like ActionMenu.
// Strings are interpreted as file or directory paths.
// File paths directly run the openAction.
// arguments for  openAction and defaultOpenAction are  |path,action,what,val| .

w = Window.new("PathActionMenu Examples").front;
w.flow{arg w;
    var m;
    m=PathActionQMenu(w,Rect(0,0,150,25),"Open Files and Dirs",[
		// an association with a custom action
		'An Action'->{|action,what,val|[action,what,val].postln},
		ActionQSubMenu("ActionQSubMenu",[
			"SubAction1",
			"SubAction2"
		]),
		"-", // a divider
        "~/Documents",
        "~/Shared",
		Platform.userAppSupportDir++"/startup.scd",
		"-UserAppSupportDir", // a divider with text
		Platform.userAppSupportDir++"/*", // '/*' will iterate over the dir on the top level

	],globalAction: {"globalAction".postln},lazyLoad: true);
	// some directories are huge, so we need to lazy load them
	// if you want defaultAction and globalAction to propogate to submenus,
    // they must be in the top menu constructor.


    m.openAction= {|path,action,what,val|
        [path,action,what,val].postln;
        Document.open(path);
        // Or use your custom editor
        // ("open -a  Sublime\\ Text "++path.escapeChar($ )).unixCmd;
    };


};


)
::

code::
//You can also create a directory of files containing
{arg v; "myFunc".postln}; // example
// and then set the openAction to

m.openAction= {|path|path.load.value(v)};
// In this way you can separate your code functions into many small files.


::
code::

(
// to attach to MainMenu use  *newMenuOnly

var pamenu;
FlowView.new.flow{|w| StaticText(w, 300@30).string_("Look at the macOS menu")};
   pamenu=PathActionQMenu.newMenuOnly(w,Rect(0,0,150,25),"Open Files and Dirs",[
        'An Action'->{|action,what,val|[action,what,val].postln},
        ActionQSubMenu("ActionQSubMenu",[
            "SubAction1",
            "SubAction2"
        ]),
        "-", // a divider
        "~/Documents",
        "~/Shared",
        Platform.userAppSupportDir++"/startup.scd",
        "-UserAppSupportDir",
        Platform.userAppSupportDir++"/*",

    ],globalAction: {"globalAction".postln},lazyLoad: true);


    pamenu.openAction= {|path,action,what,val|
        [path,action,what,val].postln;
        Document.open(path);
        // Or use your custom editor
        // ("open -a  Sublime\\ Text "++path.escapeChar($ )).unixCmd;
    };


MainMenu.register(pamenu.menu, "TestPathActions");

pamenu.menu.actions.do{|act|

MainMenu.register(act, "TestPathActions2");
}
)


